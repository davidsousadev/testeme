# Variáveis de ambiente do frontend TestMe
# Copie este arquivo para .env e preencha os valores reais.
# Nunca comite credenciais.

# URL da API backend (FastAPI). Em produção, aponte para o domínio da API.
VITE_API_URL=http://127.0.0.1:8000/testeme

# Nome da aplicação (exibido na interface)
VITE_APP_NAME=TestMe
